# Electron / electron-builder download mirrors.
#
# These are read by the install scripts rather than by npm itself, and npm 11
# reports them as unknown project config keys that will stop being honoured in
# the next major version. The supported spelling is the environment variable,
# which CI and local shells can set instead:
#
#   ELECTRON_MIRROR=https://npmmirror.com/mirrors/electron/
#   ELECTRON_BUILDER_BINARIES_MIRROR=https://npmmirror.com/mirrors/electron-builder-binaries/
#
# The legacy keys are kept so existing setups keep working.
electron_mirror=https://npmmirror.com/mirrors/electron/
electron_builder_binaries_mirror=https://npmmirror.com/mirrors/electron-builder-binaries/
